# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys. This file IS committed,
# so keep only placeholders here.

# Supabase → Project Settings → API Keys (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
# Server only. Bypasses Row Level Security — keep secret.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# SMTP used to send the sign-in (2nd step) codes.
# Gmail: enable 2-Step Verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Inventory System <you@gmail.com>"

# Long random strings, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: idle timeout in seconds before sign-out (default 1800 = 30 minutes)
# SESSION_IDLE_SECONDS=1800

# Safety: e2e tests refuse to run if NEXT_PUBLIC_SUPABASE_URL points at any of these
# project refs. Put your PRODUCTION project ref here (comma-separated).
# E2E_FORBIDDEN_PROJECT_REFS=your-prod-project-ref
